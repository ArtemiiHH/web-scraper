# Output directory for test results
OUTPUT_DIR=data/output

# Logging verbosity: info | debug | error
LOG_LEVEL=info

# Delay range between test actions (milliseconds). Keep MIN at 2000+ to be respectful.
MIN_DELAY_MS=2000
MAX_DELAY_MS=8000

# Run browser in headless mode (true) or visible (false)
HEADLESS=true

# Comma-separated list of proxy URLs for geo-distributed session testing
# Example: http://user:pass@proxy1.example.com:8080,http://user:pass@proxy2.example.com:8080
PROXY_POOL=

# Use puppeteer-real-browser (actual Chrome via CDP) for authentic TLS/JA3 fingerprinting
USE_REAL_BROWSER=false
